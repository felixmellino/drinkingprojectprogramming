# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored -- never commit real secrets.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-server-only-service-role-key"

# SMTP is required for Forgot password. Use TLS port 465 or STARTTLS port 587.
SMTP_HOST = "smtp.example.com"
SMTP_PORT = 465
SMTP_USER = "your-smtp-username"
SMTP_PASSWORD = "your-smtp-password"
SMTP_FROM = "WeGoPub <noreply@example.com>"
